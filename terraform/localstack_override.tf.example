# Copy to localstack_override.tf (gitignored) to plan against LocalStack instead of AWS.
# Terraform merges *_override.tf files into the configuration: this re-points the AWS
# provider at LocalStack so `terraform plan` of the real VPC + EKS config runs offline.
provider "aws" {
  access_key                  = "test"
  secret_key                  = "test"
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true

  endpoints {
    ec2  = "http://localhost:4566"
    eks  = "http://localhost:4566"
    iam  = "http://localhost:4566"
    kms  = "http://localhost:4566"
    sts  = "http://localhost:4566"
    ssm  = "http://localhost:4566"
    logs = "http://localhost:4566"
  }
}
