# Copy to terraform.tfvars (gitignored) and adjust.
# No credentials here: the AWS provider reads them from `aws configure` or the environment.
region              = "ap-south-1"
project             = "inventrack"
environment         = "dev"
vpc_cidr            = "10.40.0.0/16"
kubernetes_version  = "1.34"
node_instance_types = ["t3.medium"]
node_count          = { min = 2, desired = 2, max = 4 }
